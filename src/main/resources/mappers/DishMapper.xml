<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.canteen.dao.DishDAO">
    <select id="findById" parameterType="String" resultType="Dish">
        SELECT * FROM dish WHERE id = #{id}
    </select>

    <select id="findAll" resultType="Dish">
        SELECT * FROM dish
    </select>

    <insert id="save" parameterType="Dish">
        INSERT INTO dish (id, name, price, description)
        VALUES (#{id}, #{name}, #{price}, #{description})
        ON DUPLICATE KEY UPDATE
        name = #{name}, price = #{price}, description = #{description}
    </insert>

    <delete id="delete" parameterType="String">
        DELETE FROM dish WHERE id = #{id}
    </delete>
</mapper>